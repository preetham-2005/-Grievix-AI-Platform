# Grievix AI Platform Environment Configuration Template
# Copy this file to a new file named '.env' in this directory and populate with your credentials.

# -------------------------------------------------------------------------
# 1. Google Gemini AI Studio API Key
# -------------------------------------------------------------------------
# Generate a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_key_here

# -------------------------------------------------------------------------
# 2. Real SMTP Email Configuration (Gmail / SendGrid / Mailgun)
# -------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_or_smtp_address@gmail.com
# For Gmail: Use a 16-character Google App Password (not your raw account password)
SPRING_MAIL_PASSWORD=your_smtp_app_password_here

# -------------------------------------------------------------------------
# 3. Real Twilio SMS Alerts Configuration
# -------------------------------------------------------------------------
# Register for a Twilio developer console account at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_purchased_trial_number_here
